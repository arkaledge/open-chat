# Application
APP_NAME=OpenChat
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openchat
POSTGRES_USER=openchat
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# MinIO / S3
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=openchat
MINIO_SECURE=false

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# LLM Providers
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Bedrock (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Search Providers
TAVILY_API_KEY=
BRAVE_API_KEY=
SERP_API_KEY=

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SSO (Optional)
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Security
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_PII_DETECTION=true
ENABLE_CONTENT_FILTERING=true
LAKERA_GUARD_API_KEY=

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# LLM Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openchat
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# Features
ENABLE_WEB_SEARCH=true
ENABLE_RAG=true
ENABLE_FILE_UPLOAD=true
ENABLE_VOICE_INPUT=false
ENABLE_IMAGE_GENERATION=false
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_CONVERSATION=40

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@openchat.ai

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# GPU (for local model serving)
CUDA_VISIBLE_DEVICES=0
VLLM_TENSOR_PARALLEL_SIZE=1
